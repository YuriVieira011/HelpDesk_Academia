<head>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
            integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
            crossorigin="anonymous"></script>
    <title>Verificação de 2 fatores</title>
</head>
@{
    ViewData["Title"] = "Verificação de 2 fatores";
}
<h1>@ViewData["Title"]</h1>
<i class="bi bi-ui-checks" style="color: #3798ff9d;"></i>

<body>
    <div style="border: 1px solid #3798ff9d; padding: 20px;" class="mb-3">
        <form>
            <input type="text" class="form-control" id="" placeholder="Digite o código de verificação">
            <div id="" class="form-text">
                <p>Digite o código de verificação enviado para seu email ou telefone para concluir o processo de
                    cadastro.</p>
                    <a asp-area="" asp-controller="Admin" asp-action="Index_Admin" class="btn btn-primary">Verificar Admin(Temporário)</a>
                    <br><br>
                    <a asp-area="" asp-controller="User" asp-action="Index" class="btn btn-primary">Verificar</a>
                </div>
            </form>
    </div>
</body>