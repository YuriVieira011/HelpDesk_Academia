@model HelpDesk.Models.Chamado

<head>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
            integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
            crossorigin="anonymous"></script>
    <title>Cadastro</title>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cepInput = document.getElementById('inputCep');
            const rgInput = document.getElementById('inputRG');

            if (cepInput) {
                cepInput.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 5) {
                        value = value.replace(/^(\d{5})(\d)/, '$1-$2');
                    }
                    e.target.value = value.slice(0, 9);
                });
            }

            if (rgInput) {
                rgInput.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    value = value.replace(/^(\d{2})(\d)/, '$1.$2');
                    value = value.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
                    value = value.replace(/\.(\d{3})(\d)/, '.$1-$2');
                    e.target.value = value.slice(0, 15);
                });
            }
        });

        function validarFormulario() {
            let nome = document.getElementById('inputNome').value;
            let email = document.getElementById('inputEmail').value;
            let senha = document.getElementById('inputPassword5').value;
            let cep = document.getElementById('inputCep').value;
            let rg = document.getElementById('inputRG').value;

            if (nome == "") {
                alert("Digite o nome!");
                return false;
            }

            if (email == "") {
                alert("Digite o email!");
                return false;
            }

            if (senha.length < 8) {
                alert("A senha deve ter no mínimo 8 caracteres!");
                return false;
            }

            if (cep.length != 9) {
                alert("CEP inválido!");
                return false;
            }

            if (rg.length < 7 || rg.length > 15) {
                alert("RG inválido!");
                return false;
            }

            return true;
        }
    </script>
</head>
@{
    ViewData["Title"] = "Cadastro";
}
<h1>@ViewData["Title"]</h1>

<body>
    <form asp-controller="Chamados" asp-action="Criar" method="post" onsubmit="return validarFormulario()">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" type="text" class="form-control" id="inputNome">
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" id="inputEmail">
        </div>

        <div class="mb-3">
            <label asp-for="Senha" class="form-label">Senha</label>
            <input asp-for="Senha" type="password" id="inputPassword5" class="form-control">
        </div>

        <div class="mb-3">
            <label asp-for="CEP" class="form-label">CEP</label>
            <input asp-for="CEP" type="text" id="inputCep" class="form-control" maxlength="9">
        </div>

        <div class="mb-3">
            <label asp-for="RG" class="form-label">RG</label>
            <input asp-for="RG" type="text" id="inputRG" class="form-control" maxlength="15">
        </div>

        <button class="btn btn-primary" type="submit">Enviar</button>
    </form>
</body>
