@* Destaque para os alunos: Aqui não usamos List<...>, 
   pois recebemos apenas UM único objeto Chamado.
*@
@model HelpDesk.Models.Cadastro

@{
    ViewData["Title"] = "Detalhes do Cadastro";
}

<div class="container mt-4">
    <h2>Detalhes do Cadastro #@Model.Id</h2>
    <hr />

    <div class="card">
        <div class="card-header bg-primary text-white">
            Informações do Usuário
        </div>
        <div class="card-body">
            <h3 class="card-title">@Model.Nome</h5>
            <p class="card-text">
                <strong>Email:</strong><br />
                @Model.Email
            </p>
            <p class="card-text">
                <strong>Senha:</strong><br />
                @Model.Senha
            </p>
            <p class="card-text">
                <strong>CEP:</strong><br />
                @Model.CEP
            </p>
            <p class="card-text">
                <strong>RG:</strong><br />
                @Model.RG
            </p>
        </div>
        <div class="card-body">
            <p class="card-text">
                <strong>Status:</strong> @Model.Status<br />
                <strong>Data de Abertura:</strong> @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")<br />
                <strong>Data de Fechamento:</strong>
                @(Model.DataFechamento.HasValue
                    ? Model.DataFechamento.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Em aberto")
            </p>
        </div>
        <div class="card-footer text-muted">
            @* Link para voltar à lista principal *@
            <a asp-action="Lista" class="btn btn-secondary">Voltar para a Lista</a>
        </div>
    </div>
</div>