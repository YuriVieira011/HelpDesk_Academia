@model List<HelpDesk.Models.Cadastro>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <title>Lista</title>
    @{
        ViewData["Title"] = "Lista";
    }

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Senha</th>
            <th>CEP</th>
            <th>RG</th>
            <th>Status</th> 
            <th>Data de abertura</th>
            <th>Data de fechamento</th>
            <th>Ações</th> <!-- Adicionado para alinhar com o botão -->
        </tr>
    </thead>
    <tbody>
        @foreach (Cadastro cadastro in Model)
        {
            <tr>
                <td>@cadastro.Id</td>
                <td>@cadastro.Nome</td>
                <td>@cadastro.Email</td>
                <td>@cadastro.Senha</td>
                <td>@cadastro.CEP</td>
                <td>@cadastro.RG</td>
                <td>@cadastro.Status</td>
                <td>@cadastro.DataAbertura.ToString("dd/MM/yyyy")</td>
                <td>
                    @(cadastro.DataFechamento.HasValue
                    ? cadastro.DataFechamento.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Em aberto")
                </td>
                <td>
                    <a asp-controller="Cadastros" asp-action="Detalhes" asp-route-id="@cadastro.Id"
                       class="btn btn-primary btn-sm">
                        Ver Detalhes
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>