@model List<HelpDesk.Models.Cadastro>
@{
    Layout = "_Layout_admin";
    ViewData["Title"] = "Lista";
}

<div class="container mt-4">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Senha</th>
                    <th>CEP</th>
                    <th>RG</th>
                    <th>Tipo de usuário</th>
                    <th>Data de abertura</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Cadastro cadastro in Model)
                {
                    <tr>
                        <td>@cadastro.Id</td>
                        <td>@cadastro.Nome</td>
                        <td>@cadastro.Email</td>
                        <td><code>@cadastro.Senha</code></td>
                        <td>@cadastro.CEP</td>
                        <td>@cadastro.RG</td>
                        <td>@cadastro.User</td>
                        <td>@cadastro.DataAbertura.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-controller="Cadastros" asp-action="Detalhes" asp-route-id="@cadastro.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-eye"></i> Ver Detalhes
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>