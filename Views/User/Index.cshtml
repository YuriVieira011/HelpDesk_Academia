@model IEnumerable<Spotter.Models.Maquina>
@using Spotter.Models

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <title>Index</title>
    <style>
        /* Botões */
        .btn-vermelho {
            background-color: var(--vermelho-principal);
            color: var(--branco-puro);
            font-weight: bold;
            border: none;
            transition: 0.3s;
        }
        .btn-vermelho:hover {
            background-color: var(--vermelho-escuro);
            color: var(--branco-puro);
        }
        .btn-outline-vermelho {
            border: 2px solid var(--vermelho-principal);
            color: var(--vermelho-principal);
            font-weight: bold;
            background-color: transparent;
            transition: 0.3s;
        }
        .btn-outline-vermelho:hover {
            background-color: var(--vermelho-principal);
            color: var(--branco-puro);
        }

        /* Cards de Modalidades */
        .card-modalidade {
            border: none;
            border-bottom: 4px solid var(--vermelho-principal);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s;
        }
        .card-modalidade:hover {
            transform: translateY(-5px);
        }
        .icon-box {
            color: var(--vermelho-principal);
            font-size: 2.5rem;
        }

        /* Seção de Planos */
        .bg-planos {
            background-color: var(--cinza-claro);
        }
        .card-plano {
            transition: transform 0.3s;
        }
        .card-plano:hover{
            transform: translateY(-5px);
        }
        .badge-vermelho {
            background-color: var(--vermelho-principal);
            color: var(--branco-puro);
        }
        .emuso{
            color:#dc3545;
        }
        .aberto{
            color:#198754;
        }
    </style>
</head>

@{
    Layout = "_Layout_user";
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="fw-bold text-uppercase" style="color: #dc3545;">Bem-vindo à Academia Mr. Bombastic</h1>
    <br />
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase">Nossas <span class="text-danger">Máquinas</span></h2>
        <div class="mx-auto bg-danger" style="width: 60px; height: 3px;"></div>
    </div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Marca</th>
            <th>Nº Série</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhuma máquina encontrada.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nome</strong></td>
                    <td>@item.Marca</td>
                    <td>@(item.NumeroSerie ?? "-")</td>
                    <td>
                        @if (item.Status == StatusMaquina.Operacional)
                        {
                            <span class="badge bg-success">Operacional</span>
                        }
                        else if (item.Status == StatusMaquina.EmManutencao)
                        {
                            <span class="badge bg-warning text-dark">Em Manutenção</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inoperante</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

    <section id="modalidades" class="py-5">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-uppercase">Nossas <span class="text-danger">Modalidades</span></h2>
                <div class="mx-auto bg-danger" style="width: 60px; height: 3px;"></div>
            </div>
            
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 card-modalidade text-center p-4">
                        <div class="card-body">
                            <div class="icon-box mb-3">
                                <i class="bi bi-capslock-fill"></i>
                            </div>
                            <h4 class="card-title fw-bold text-uppercase">Musculação</h4>
                            <p class="card-text text-muted">Equipamentos modernos e profissionais qualificados para guiar seu treino de força.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 card-modalidade text-center p-4">
                        <div class="card-body">
                            <div class="icon-box mb-3">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <h4 class="card-title fw-bold text-uppercase">Cross Training</h4>
                            <p class="card-text text-muted">Aulas de alta intensidade para queimar calorias e melhorar seu condicionamento físico.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 card-modalidade text-center p-4">
                        <div class="card-body">
                            <div class="icon-box mb-3">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <h4 class="card-title fw-bold text-uppercase">Dança / Ritmos</h4>
                            <p class="card-text text-muted">Divirta-se enquanto se exercita com as coreografias mais animadas do momento.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <br>
</div>